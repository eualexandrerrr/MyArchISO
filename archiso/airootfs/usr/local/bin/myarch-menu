#!/usr/bin/env bash
# Menu do live ISO do myarch. Roda no tty1 depois do autologin; tambem pode ser chamado a mao.

BLU=$'\e[1;34m'; GRN=$'\e[1;32m'; YEL=$'\e[1;33m'; BLD=$'\e[1m'; END=$'\e[0m'
INSTALLER=/root/myarch/install.sh

rede_ok() { ping -c1 -W2 archlinux.org &>/dev/null; }

while true; do
    clear
    printf '%s' "$BLU"
    cat <<'BANNER'
                    _
   _ __ ___  _   _ / \   _ __ ___| |__
  | '_ ` _ \| | | / _ \ | '__/ __| '_ \
  | | | | | | |_| / ___ \| | | (__| | | |
  |_| |_| |_|\__, /_/   \_\_|  \___|_| |_|
             |___/
BANNER
    printf '%s\n' "$END"
    if rede_ok; then printf '  rede: %sok%s\n' "$GRN" "$END"; else printf '  rede: %ssem internet%s (o instalador precisa; opcao 2 para Wi-Fi)\n' "$YEL" "$END"; fi
    printf '  teclado: br-abnt2\n\n'
    printf '  %s1%s) Instalar Arch com o myarch (APAGA o disco escolhido; ele pede confirmacao)\n' "$BLD" "$END"
    printf '  %s2%s) Conectar no Wi-Fi (iwctl)\n' "$BLD" "$END"
    printf '  %s3%s) Baixar a versao mais nova do instalador (git) e instalar\n' "$BLD" "$END"
    printf '  %s4%s) Shell\n' "$BLD" "$END"
    printf '  %s5%s) Desligar\n\n' "$BLD" "$END"
    read -rp '  opcao: ' op
    case "$op" in
        1) bash "$INSTALLER"; read -rp $'\n  [enter] volta ao menu ' _ ;;
        2) printf '\n  dentro do iwctl: station wlan0 scan | station wlan0 get-networks | station wlan0 connect NOME | exit\n\n'; iwctl ;;
        3) rede_ok || { printf '  sem internet\n'; sleep 2; continue; }
           rm -rf /root/myarch-git && git clone --depth 1 https://github.com/eualexandrerrr/myarch /root/myarch-git \
             && bash /root/myarch-git/install.sh; read -rp $'\n  [enter] volta ao menu ' _ ;;
        4) printf '\n  digite myarch-menu para voltar\n\n'; exit 0 ;;
        5) poweroff ;;
        *) ;;
    esac
done
