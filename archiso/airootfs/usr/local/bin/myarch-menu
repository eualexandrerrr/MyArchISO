#!/usr/bin/env bash
# Menu do live ISO do myarch. Roda no tty1 depois do autologin; tambem pode ser chamado a mao.
#
# O instalador NAO vem da ISO: e baixado do GitHub na hora, como o primeiro-logon.ps1 do MyWinISO
# faz com o setup.ps1. A copia embutida existe so como plano B para quando nao ha rede.
#
# O motivo: a ISO congela o install.sh do commit em que foi gerada, e uma ISO de duas semanas atras
# instala o sistema de duas semanas atras. Isso ja quase custou caro -- a ISO de 05/09/2026 carrega a
# versao que apagava o disco inteiro, sem preservar a particao de dados, e ela continuaria fazendo
# isso para sempre. Buscar na hora faz a ISO envelhecer sem apodrecer.

BLU=$'\e[1;34m'; GRN=$'\e[1;32m'; YEL=$'\e[1;33m'; RED=$'\e[1;31m'; BLD=$'\e[1m'; END=$'\e[0m'

REPO=https://github.com/eualexandrerrr/MyArchISO
RAW=https://raw.githubusercontent.com/eualexandrerrr/MyArchISO/main/install.sh
RAW_MENU=https://raw.githubusercontent.com/eualexandrerrr/MyArchISO/main/archiso/airootfs/usr/local/bin/myarch-menu
EMBUTIDO=/root/myarch/install.sh
BAIXADO=/root/myarch-novo/install.sh
DOTFILES=https://github.com/eualexandrerrr/dotfiles.git

# Ponto unico de montagem do sistema do disco. Tudo que conserta alguma coisa passa por aqui.
RAIZ=/mnt/sys

rede_ok() { ping -c1 -W2 archlinux.org &>/dev/null; }
conf_ok() { blkid -L Ventoy &>/dev/null; }
pausa()   { read -rp $'\n  [enter] volta ao menu ' _; }

# O mesmo raciocinio do install.sh, aplicado ao proprio menu: a ISO congela este arquivo no
# commit em que foi gerada, entao uma opcao nova so chegaria ao pendrive regerando a imagem.
# Aqui ele se troca pela versao do GitHub e reexecuta uma unica vez -- MYARCH_MENU_ATUALIZADO
# corta o laco, senao a versao nova baixaria de novo e reiniciaria pra sempre.
#
# So troca se o arquivo baixado for um bash valido e diferente do atual. Um download pela
# metade sobrescreveria o menu por lixo e deixaria o live sem interface nenhuma.
autoatualiza() {
    [[ -n ${MYARCH_MENU_ATUALIZADO:-} ]] && return 0
    rede_ok || return 0
    local novo=/tmp/myarch-menu.novo
    curl -fsSL --max-time 15 -o "$novo" "$RAW_MENU" 2>/dev/null || return 0
    [[ -s $novo ]] || { rm -f "$novo"; return 0; }
    head -1 "$novo" | grep -q '^#!.*bash' || { rm -f "$novo"; return 0; }
    bash -n "$novo" 2>/dev/null || { rm -f "$novo"; return 0; }
    cmp -s "$novo" "$0" && { rm -f "$novo"; return 0; }
    install -m755 "$novo" /usr/local/bin/myarch-menu
    rm -f "$novo"
    printf '  %sok%s menu atualizado a partir do GitHub\n' "$GRN" "$END" >&2
    sleep 1
    MYARCH_MENU_ATUALIZADO=1 exec /usr/local/bin/myarch-menu "$@"
}

autoatualiza "$@"

# Um install.sh so serve se souber preservar particao por rotulo. Sem esta checagem, um instalador
# antigo (da ISO, ou um download que veio pela metade) apagaria a particao de dados sem avisar.
# Vale para o baixado E para o embutido: os dois passam pelo mesmo crivo.
protege_particao() {
    [[ -s $1 ]] || return 1
    head -1 "$1" | grep -q '^#!.*bash' || return 1
    grep -q 'KEEP_LABELS'          "$1" || return 1
    grep -q 'particoes_protegidas' "$1" || return 1
    return 0
}

versao_embutida() {
    # -s e nao -r: um VERSAO vazio (ja aconteceu, por clone raso no CI) faria o aviso sair como
    # "copia embutida ()", que e pior que nao dizer nada. Vazio cai para a data do arquivo.
    if [[ -s /root/myarch/VERSAO ]]; then cat /root/myarch/VERSAO
    elif [[ -e $EMBUTIDO ]]; then date -r "$EMBUTIDO" '+%d/%m/%Y'
    else echo 'desconhecida'; fi
}

# Devolve, na saida padrao, o caminho do instalador a usar. Vazio = nao ha instalador confiavel.
pega_instalador() {
    local i resp http tam
    if rede_ok; then
        mkdir -p "$(dirname "$BAIXADO")"
        for i in 1 2 3; do
            printf '  %s--%s baixando o instalador do GitHub (tentativa %d de 3)\n' "$BLU" "$END" "$i" >&2
            # -w para mostrar o codigo HTTP e o tamanho: prova de que veio de la agora, e nao de cache
            http="$(curl -fsSL --max-time 20 -w '%{http_code}' -o "$BAIXADO.tmp" "$RAW" 2>/dev/null)" && {
                tam="$(stat -c%s "$BAIXADO.tmp" 2>/dev/null || echo 0)"
                if [[ $http == 200 ]] && protege_particao "$BAIXADO.tmp"; then
                    mv -f "$BAIXADO.tmp" "$BAIXADO"; chmod +x "$BAIXADO"
                    printf '  %sok%s HTTP %s, %s bytes -- usando a versao mais nova do GitHub\n' "$GRN" "$END" "$http" "$tam" >&2
                    printf '%s\n' "$BAIXADO"; return 0
                fi
                printf '  %s!!%s resposta invalida (HTTP %s, %s bytes); descartada\n' "$YEL" "$END" "$http" "$tam" >&2
            }
            rm -f "$BAIXADO.tmp"
            sleep 3
        done
        printf '  %s!!%s nao consegui baixar depois de 3 tentativas\n' "$YEL" "$END" >&2
    else
        printf '  %s!!%s sem internet\n' "$YEL" "$END" >&2
    fi

    # plano B: a copia que veio na ISO
    if protege_particao "$EMBUTIDO"; then
        printf '  %s!!%s usando a copia embutida na ISO (%s). Ela preserva as particoes, mas pode estar\n' "$YEL" "$END" "$(versao_embutida)" >&2
        printf '     atras do repositorio. Com rede, prefira baixar.\n' >&2
        printf '%s\n' "$EMBUTIDO"; return 0
    fi

    printf '\n  %sPAREI.%s O instalador embutido nesta ISO (%s) NAO sabe preservar particao por rotulo:\n' "$RED" "$END" "$(versao_embutida)" >&2
    printf '  ele apagaria o disco inteiro, incluindo a particao de dados. E preciso rede para baixar\n' >&2
    printf '  a versao nova, ou gere uma ISO nova a partir de %s\n' "$REPO" >&2
    return 1
}

# ---------------------------------------------------------------------------
# Montagem do sistema do disco
#
# Toda opcao de conserto precisa do mesmo comeco: ROOT em /mnt/sys, a particao de dados
# em /mnt/sys/home e a ESP em /mnt/sys/boot. Estava duplicado dentro de reinstalar_dotfiles;
# virou funcao porque agora tem meia duzia de coisas usando.
#
# A ordem importa: /home e /boot sao filhos de ROOT, entao ROOT vai primeiro. Sem a ESP
# montada, bootctl e mkinitcpio geram arquivo no lugar errado e o disco continua sem bootar.
# ---------------------------------------------------------------------------

montar_sistema() {
    mkdir -p "$RAIZ"
    if ! mountpoint -q "$RAIZ"; then
        mount /dev/disk/by-label/ROOT "$RAIZ" 2>/dev/null || {
            printf '  %s!!%s nao achei a particao ROOT\n' "$RED" "$END"
            return 1
        }
    fi
    if blkid -L Files &>/dev/null; then
        mountpoint -q "$RAIZ/home" || mount /dev/disk/by-label/Files "$RAIZ/home" 2>/dev/null
    fi
    mountpoint -q "$RAIZ/boot" || mount /dev/disk/by-label/EFI "$RAIZ/boot" 2>/dev/null
    # sem resolv.conf o chroot nao resolve nome nenhum, e todo pacman de dentro falha
    cp -f /etc/resolv.conf "$RAIZ/etc/resolv.conf" 2>/dev/null
    printf '  %sok%s ROOT em %s' "$GRN" "$END" "$RAIZ"
    mountpoint -q "$RAIZ/home" && printf ', dados em %s/home' "$RAIZ"
    mountpoint -q "$RAIZ/boot" && printf ', ESP em %s/boot' "$RAIZ"
    printf '\n'
    return 0
}

desmontar_sistema() {
    umount -R "$RAIZ" 2>/dev/null
}

dono_do_sistema() {
    awk -F: '$3 == 1000 { print $1 }' "$RAIZ/etc/passwd" 2>/dev/null | head -1
}

# Roda um comando dentro do sistema instalado, montando antes e desmontando depois.
# Uso: no_sistema 'titulo do que vai fazer' comando...
no_sistema() {
    local titulo=$1; shift
    printf '\n  %s--%s %s\n' "$BLU" "$END" "$titulo"
    montar_sistema || { pausa; return 1; }
    arch-chroot "$RAIZ" "$@"
    local rc=$?
    desmontar_sistema
    if [[ $rc -eq 0 ]]; then printf '\n  %sok%s terminou sem erro\n' "$GRN" "$END"
    else printf '\n  %s!!%s terminou com erro (codigo %d)\n' "$RED" "$END" "$rc"; fi
    pausa
    return $rc
}

# ---------------------------------------------------------------------------
# Dotfiles
# ---------------------------------------------------------------------------

# Reinstala so os dotfiles num sistema que ja existe no disco, sem tocar em particao nenhuma.
# Existe porque a config do desktop mora em /home, que sobrevive a formatacao: reinstalar o
# Arch inteiro nao conserta um Hyprland que nao sobe, e a unica saida ate hoje era montar tudo
# a mao pelo shell. Aqui monta ROOT, poe a particao de dados em /home, faz chroot e roda o
# install.sh do repo de dotfiles como o dono do /home -- que e quem tem os symlinks do stow.
reinstalar_dotfiles() {
    local usuario rc
    printf '\n  %s--%s montando o sistema instalado\n' "$BLU" "$END"
    montar_sistema || { pausa; return; }

    usuario="$(dono_do_sistema)"
    if [[ -z $usuario ]]; then
        printf '  %s!!%s nao achei o usuario de uid 1000 em %s/etc/passwd\n' "$RED" "$END" "$RAIZ"
        desmontar_sistema; pausa; return
    fi
    printf '  %sok%s usuario %s\n' "$GRN" "$END" "$usuario"

    if ! rede_ok; then
        printf '  %s!!%s sem internet: os dotfiles vem do GitHub, nao da ISO\n' "$RED" "$END"
        desmontar_sistema; pausa; return
    fi

    printf '  %s--%s apagando ~/.dotfiles e clonando de novo\n' "$BLU" "$END"
    arch-chroot "$RAIZ" /usr/bin/su - "$usuario" -c "
        set -e
        rm -rf \"\$HOME/.dotfiles\"
        git clone --depth 1 $DOTFILES \"\$HOME/.dotfiles\"
        bash \"\$HOME/.dotfiles/install.sh\"
    "
    rc=$?

    desmontar_sistema
    if [[ $rc -eq 0 ]]; then
        printf '\n  %sok%s dotfiles reinstalados. Reiniciando em 10 s ([enter] reinicia agora, [esc] cancela)\n' "$GRN" "$END"
        local tecla
        if read -rs -t 10 -n 1 tecla; then
            [[ $tecla == $'\e' ]] && { printf '  reinicio cancelado\n'; pausa; return; }
        fi
        reboot
    else
        printf '\n  %s!!%s o install.sh dos dotfiles terminou com erro (codigo %d)\n' "$RED" "$END" "$rc"
        pausa
    fi
}

# So reaplica a config: nao clona nada, nao instala pacote, nao mexe na rede. E o caminho
# para quando o repo ja esta no lugar e o que quebrou foi o link ou a config do compositor.
reaplicar_config() {
    local usuario
    printf '\n  %s--%s montando o sistema instalado\n' "$BLU" "$END"
    montar_sistema || { pausa; return; }

    usuario="$(dono_do_sistema)"
    if [[ -z $usuario ]]; then
        printf '  %s!!%s nao achei o usuario de uid 1000\n' "$RED" "$END"
        desmontar_sistema; pausa; return
    fi
    if [[ ! -d $RAIZ/home/$usuario/.dotfiles ]]; then
        printf '  %s!!%s %s nao tem ~/.dotfiles. Use a opcao que reclona do GitHub.\n' "$RED" "$END" "$usuario"
        desmontar_sistema; pausa; return
    fi

    arch-chroot "$RAIZ" /usr/bin/su - "$usuario" -c 'bash "$HOME/.dotfiles/setup.sh"'
    local rc=$?
    desmontar_sistema
    if [[ $rc -eq 0 ]]; then printf '\n  %sok%s config reaplicada\n' "$GRN" "$END"
    else printf '\n  %s!!%s setup.sh terminou com erro (codigo %d)\n' "$RED" "$END" "$rc"; fi
    pausa
}

# ---------------------------------------------------------------------------
# Recuperacao
# ---------------------------------------------------------------------------

abrir_chroot() {
    printf '\n  %s--%s montando o sistema instalado\n' "$BLU" "$END"
    montar_sistema || { pausa; return; }
    printf '\n  Voce esta DENTRO do sistema do disco. Saia com "exit" para desmontar e voltar.\n\n'
    arch-chroot "$RAIZ" /bin/bash
    desmontar_sistema
    printf '\n  %sok%s desmontado\n' "$GRN" "$END"
    pausa
}

# fsck exige a particao desmontada, senao ele recusa ou corrompe. Por isso desmonta tudo antes
# e trata cada rotulo separado. O codigo 1 do e2fsck quer dizer "corrigi erros", nao falha.
checar_discos() {
    local alvo dev rc
    printf '\n  %s--%s desmontando tudo antes de checar\n' "$BLU" "$END"
    desmontar_sistema
    for alvo in ROOT Files; do
        dev="$(blkid -L "$alvo" 2>/dev/null)"
        if [[ -z $dev ]]; then
            printf '  %s!!%s rotulo %s nao existe neste disco\n' "$YEL" "$END" "$alvo"
            continue
        fi
        if findmnt -S "$dev" &>/dev/null; then
            printf '  %s!!%s %s (%s) ainda esta montada; pulei\n' "$YEL" "$END" "$alvo" "$dev"
            continue
        fi
        printf '\n  %s--%s e2fsck -fp em %s (%s)\n' "$BLU" "$END" "$alvo" "$dev"
        e2fsck -fp "$dev"; rc=$?
        case $rc in
            0) printf '  %sok%s %s sem erros\n' "$GRN" "$END" "$alvo" ;;
            1) printf '  %sok%s %s tinha erros e foram corrigidos\n' "$GRN" "$END" "$alvo" ;;
            2) printf '  %s!!%s %s corrigido, mas precisa reiniciar\n' "$YEL" "$END" "$alvo" ;;
            4) printf '  %s!!%s %s tem erro que o modo automatico nao resolve.\n' "$RED" "$END" "$alvo"
               printf '     Rode a mao no shell: e2fsck -fy %s\n' "$dev" ;;
            *) printf '  %s!!%s e2fsck saiu com %d em %s\n' "$RED" "$END" "$rc" "$alvo" ;;
        esac
    done
    pausa
}

# Disco que nao bota mais o menu do systemd-boot na tela: reescreve o bootloader na ESP
# e regrava a entrada de NVRAM. Nao mexe em particao, so em arquivo dentro da ESP.
reinstalar_bootloader() {
    printf '\n  %s--%s montando o sistema instalado\n' "$BLU" "$END"
    montar_sistema || { pausa; return; }
    if ! mountpoint -q "$RAIZ/boot"; then
        printf '  %s!!%s a ESP (rotulo EFI) nao montou; sem ela nao da para reinstalar o boot\n' "$RED" "$END"
        desmontar_sistema; pausa; return
    fi
    arch-chroot "$RAIZ" bootctl install
    arch-chroot "$RAIZ" bootctl update
    printf '\n  %s--%s entradas que o systemd-boot enxerga agora:\n' "$BLU" "$END"
    arch-chroot "$RAIZ" bootctl list
    desmontar_sistema
    pausa
}

regerar_initramfs() {
    no_sistema 'regerando o initramfs de todos os kernels' mkinitcpio -P
}

# Kernel meio instalado, update interrompido no meio, /usr/lib/modules sem os modulos do
# kernel que esta no boot: reinstala os pacotes de base sem tocar em mais nada.
reinstalar_base() {
    printf '\n  %s--%s isto baixa pacote: precisa de rede\n' "$BLU" "$END"
    rede_ok || { printf '  %s!!%s sem internet\n' "$RED" "$END"; pausa; return; }
    no_sistema 'reinstalando linux-zen, firmware e systemd' \
        pacman -S --noconfirm linux-zen linux-zen-headers linux-firmware systemd
}

# "invalid or corrupted package (PGP signature)" depois de um tempo sem atualizar: as chaves
# do keyring venceram. Recria o chaveiro e traz mirror novo.
consertar_pacman() {
    printf '\n  %s--%s isto baixa pacote: precisa de rede\n' "$BLU" "$END"
    rede_ok || { printf '  %s!!%s sem internet\n' "$RED" "$END"; pausa; return; }
    printf '  %s--%s montando o sistema instalado\n' "$BLU" "$END"
    montar_sistema || { pausa; return; }
    arch-chroot "$RAIZ" bash -c '
        set -x
        rm -rf /var/lib/pacman/sync
        pacman-key --init
        pacman-key --populate archlinux
        pacman -Sy --noconfirm archlinux-keyring
    '
    local rc=$?
    desmontar_sistema
    if [[ $rc -eq 0 ]]; then printf '\n  %sok%s keyring refeito\n' "$GRN" "$END"
    else printf '\n  %s!!%s terminou com erro (codigo %d)\n' "$RED" "$END" "$rc"; fi
    pausa
}

trocar_senha() {
    local usuario alvo
    printf '\n  %s--%s montando o sistema instalado\n' "$BLU" "$END"
    montar_sistema || { pausa; return; }
    usuario="$(dono_do_sistema)"
    printf '  usuario de uid 1000: %s\n' "${usuario:-nao achei}"
    read -rp '  trocar a senha de quem? [enter usa o de cima, ou digite root] ' alvo
    [[ -z $alvo ]] && alvo="$usuario"
    if [[ -z $alvo ]]; then
        printf '  %s!!%s sem usuario para trocar\n' "$RED" "$END"
        desmontar_sistema; pausa; return
    fi
    arch-chroot "$RAIZ" passwd "$alvo"
    desmontar_sistema
    pausa
}

# O journal do sistema instalado fica em /var/log/journal e pode ser lido de fora, sem chroot.
# -b -1 e o boot anterior: e nele que esta o erro que deixou a maquina neste estado.
ver_log() {
    printf '\n  %s--%s montando o sistema instalado\n' "$BLU" "$END"
    montar_sistema || { pausa; return; }
    if [[ ! -d $RAIZ/var/log/journal ]]; then
        printf '  %s!!%s este sistema nao guarda journal em disco\n' "$YEL" "$END"
        desmontar_sistema; pausa; return
    fi
    printf '\n  %s--%s erros do ultimo boot (q sai)\n\n' "$BLU" "$END"
    journalctl -D "$RAIZ/var/log/journal" -b -1 -p err --no-pager | tail -60
    printf '\n  %s--%s ultimas 40 linhas do boot inteiro\n\n' "$BLU" "$END"
    journalctl -D "$RAIZ/var/log/journal" -b -1 --no-pager | tail -40
    desmontar_sistema
    pausa
}

ver_discos() {
    printf '\n  %s--%s discos, rotulos e tamanho\n\n' "$BLU" "$END"
    lsblk -o NAME,SIZE,FSTYPE,LABEL,PARTLABEL,MOUNTPOINTS
    printf '\n  %s--%s rotulos que o myarch usa\n\n' "$BLU" "$END"
    local alvo dev
    for alvo in ROOT Files EFI Ventoy; do
        dev="$(blkid -L "$alvo" 2>/dev/null)"
        if [[ -n $dev ]]; then printf '  %sok%s %-7s %s\n' "$GRN" "$END" "$alvo" "$dev"
        else printf '  %s--%s %-7s nao existe\n' "$YEL" "$END" "$alvo"; fi
    done
    if montar_sistema; then
        printf '\n  %s--%s espaco livre\n\n' "$BLU" "$END"
        df -h "$RAIZ" "$RAIZ/home" "$RAIZ/boot" 2>/dev/null
        desmontar_sistema
    fi
    pausa
}

menu_recuperar() {
    local op
    while true; do
        clear
        printf '%s' "$BLU"
        printf '  %s\n' '=================================' '   R E C U P E R A R   |   myarch' '================================='
        printf '%s\n' "$END"
        printf '  Nada aqui formata disco. Tudo monta o sistema em %s e desmonta ao sair.\n\n' "$RAIZ"
        printf '  %s1%s) Abrir um shell dentro do sistema instalado (chroot)\n' "$BLD" "$END"
        printf '  %s2%s) Checar e reparar os sistemas de arquivos (e2fsck em ROOT e Files)\n' "$BLD" "$END"
        printf '  %s3%s) Reinstalar o systemd-boot e regravar as entradas\n' "$BLD" "$END"
        printf '  %s4%s) Regerar o initramfs (mkinitcpio -P)\n' "$BLD" "$END"
        printf '  %s5%s) Reinstalar kernel, firmware e systemd\n' "$BLD" "$END"
        printf '  %s6%s) Consertar o pacman: refazer o keyring e o banco de sync\n' "$BLD" "$END"
        printf '  %s7%s) Trocar a senha de um usuario\n' "$BLD" "$END"
        printf '  %s8%s) Ver o log do ultimo boot que falhou\n' "$BLD" "$END"
        printf '  %s9%s) Discos, rotulos e espaco livre\n' "$BLD" "$END"
        printf '  %s0%s) Voltar\n\n' "$BLD" "$END"
        read -rp '  opcao: ' op
        case "$op" in
            1) abrir_chroot ;;
            2) checar_discos ;;
            3) reinstalar_bootloader ;;
            4) regerar_initramfs ;;
            5) reinstalar_base ;;
            6) consertar_pacman ;;
            7) trocar_senha ;;
            8) ver_log ;;
            9) ver_discos ;;
            0) return ;;
            *) ;;
        esac
    done
}

instalar() {   # $1 = "auto" ou "perguntando"
    local inst
    inst="$(pega_instalador)" || { pausa; return; }
    if [[ $1 == auto ]]; then AUTO=1 bash "$inst"; else bash "$inst"; fi
    pausa
}

while true; do
    clear
    printf '%s' "$BLU"
    printf '  %s\n' '=================================' '   M Y A R C H   |   Arch Linux' '================================='
    printf '%s\n' "$END"
    if rede_ok; then printf '  rede: %sok%s (o instalador vem do GitHub na hora)\n' "$GRN" "$END"
    else printf '  rede: %ssem internet%s -- o instalador cai para a copia da ISO (%s)\n' "$YEL" "$END" "$(versao_embutida)"; fi
    if conf_ok; then printf '  pendrive Ventoy: %sachado%s (le myarch/myarch.conf se existir)\n' "$GRN" "$END"; else printf '  pendrive Ventoy: nao achado (a senha vai ser perguntada)\n'; fi
    if blkid -L ROOT &>/dev/null; then printf '  sistema no disco: %sachado%s (da para consertar sem formatar)\n' "$GRN" "$END"
    else printf '  sistema no disco: nao achei o rotulo ROOT\n'; fi
    printf '  teclado: br-abnt2   fuso: America/Sao_Paulo\n\n'
    printf '  %sINSTALAR%s\n' "$BLD" "$END"
    printf '  %s1%s) AUTOMATICO: maior disco interno, hostname RRR, usuario alexandre,\n' "$BLD" "$END"
    printf '     senha do pendrive, dotfiles no primeiro boot. %sAPAGA o disco%s apos 10 s de aviso\n' "$RED" "$END"
    printf '     (a particao de dados e a /home sao preservadas pelo rotulo).\n'
    printf '  %s2%s) Perguntando disco, hostname, usuario e senhas\n' "$BLD" "$END"
    printf '  %s3%s) Usar a copia embutida na ISO (%s), sem baixar\n\n' "$BLD" "$END" "$(versao_embutida)"
    printf '  %sSEM FORMATAR NADA%s\n' "$BLD" "$END"
    printf '  %s4%s) Rebaixar os dotfiles: apaga ~/.dotfiles, clona do GitHub, roda o install.sh\n' "$BLD" "$END"
    printf '  %s5%s) So reaplicar a config (setup.sh), sem clonar nem instalar pacote\n' "$BLD" "$END"
    printf '  %s6%s) Recuperar / consertar o sistema instalado %s>%s\n\n' "$BLD" "$END" "$BLD" "$END"
    printf '  %s7%s) Shell\n' "$BLD" "$END"
    printf '  %s8%s) Reiniciar\n' "$BLD" "$END"
    printf '  %s9%s) Desligar\n\n' "$BLD" "$END"
    read -rp '  opcao: ' op
    case "$op" in
        1) instalar auto ;;
        2) instalar perguntando ;;
        3) if protege_particao "$EMBUTIDO"; then
               printf '  %s!!%s copia embutida (%s), sem baixar nada\n' "$YEL" "$END" "$(versao_embutida)"
               bash "$EMBUTIDO"
           else
               printf '\n  %sPAREI.%s A copia embutida nesta ISO (%s) nao preserva particao por rotulo:\n' "$RED" "$END" "$(versao_embutida)"
               printf '  ela apagaria o disco inteiro. Use a opcao 1 ou 2 com rede.\n'
           fi
           pausa ;;
        4) reinstalar_dotfiles ;;
        5) reaplicar_config ;;
        6) menu_recuperar ;;
        7) printf '\n  digite myarch-menu para voltar\n\n'; exit 0 ;;
        8) reboot ;;
        9) poweroff ;;
        *) ;;
    esac
done
